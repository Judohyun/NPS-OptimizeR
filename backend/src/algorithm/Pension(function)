#### 시뮬레이션 실행 ####

def main():
    user_info = get_user_input()

    lump_sum_result = generate_lump_sum_result(user_info)

    annual_public = calculate_public_pension(user_info) * 12
    annual_private = calculate_private_pension(user_info) * 12
    total_tax = calculate_total_tax(user_info, annual_public, annual_private, is_lump_sum=user_info.get("Private_lump_sum", False))

    net_annual = annual_public + annual_private - total_tax
    net_monthly = net_annual / 12

    result = {
        "공적연금 연간 수령액": int(annual_public),
        "개인연금 연간 수령액": int(annual_private),
        "총 세금": int(total_tax),
        "세후 연간 수령액": int(net_annual),
        "세후 월 수령액": int(net_monthly)
    }

    print("\n[연금 수령 요약 결과]")
    for k, v in result.items():
        print(f"{k}: {v:,}원")

    print("\n[일시금 결과]")
    for k, v in lump_sum_result.items():
        print(f"{k}: {v:,}원") 
