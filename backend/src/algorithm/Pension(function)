#### 세금 계산  ####

def calculate_lump_sum_tax(lump_sum): # 일시금 세금 계산
    tax_rate = 0.22
    return lump_sum * tax_rate

def calculate_private_tax(user_info, annual_private_pension, is_lump_sum=False): # 개인연금 세금 계산
    if annual_private_pension <= 0:
        return 0
    if is_lump_sum:
        tax_rate = 0.165
    else:
        age = user_info["Current_age"]
        if age < 70:
            tax_rate = 0.055
        elif 70 <= age < 80:
            tax_rate = 0.044
        else:
            tax_rate = 0.033
    return annual_private_pension * tax_rate

def calculate_public_tax(user_info, annual_public_pension): # 노령연금 세금 계산
    return calculate_tax(user_info, annual_public_pension, 0)

def calculate_total_tax(user_info, annual_public_pension, annual_private_pension, is_lump_sum=False): # 전체 세금 계산(분리과세/종합과세 판별)
    total_annual_pension = annual_public_pension + annual_private_pension
    if total_annual_pension <= 12000000:
        public_tax = calculate_public_tax(user_info, annual_public_pension)
        private_tax = calculate_private_tax(user_info, annual_private_pension, is_lump_sum)
        total_tax = public_tax + private_tax
    else:
        total_tax = calculate_tax(user_info, annual_public_pension, annual_private_pension)
    return total_tax

def calculate_tax(user_info, annual_public_pension, annual_private_pension): # 노령연금 세금 계산 , 분리과세,종합과세 세금 계산
    total_annual_pension = annual_public_pension + annual_private_pension
    if total_annual_pension <= 12000000:
        annual_pension = annual_public_pension
        if annual_pension <= 3500000:
            deduction = annual_pension
        elif annual_pension <= 7000000:
            deduction = 3500000 + (annual_pension - 3500000) * 0.4
        elif annual_pension <= 14000000:
            deduction = 4900000 + (annual_pension - 7000000) * 0.2
        else:
            deduction = 6300000 + (annual_pension - 14000000) * 0.1
        additional_deduction = 0
        if user_info.get("Spouse") == 'Y':
            additional_deduction += 500000
        additional_deduction += (user_info.get("Dependent_parent_count", 0) + user_info.get("Child_count", 0)) * 500000
        total_deduction = deduction + additional_deduction
        taxable_income = max(annual_pension - total_deduction, 0)
    else:
        basic_deduction = 1500000
        if user_info.get("Spouse") == 'Y':
            basic_deduction += 1500000
        basic_deduction += (user_info.get("Dependent_parent_count", 0) + user_info.get("Child_count", 0)) * 1500000
        taxable_income = max(total_annual_pension - basic_deduction, 0)
    if taxable_income <= 12000000:
        tax = taxable_income * 0.06
    elif taxable_income <= 46000000:
        tax = taxable_income * 0.15 - 1080000
    elif taxable_income <= 88000000:
        tax = taxable_income * 0.24 - 5220000
    elif taxable_income <= 150000000:
        tax = taxable_income * 0.35 - 14900000
    elif taxable_income <= 300000000:
        tax = taxable_income * 0.38 - 19400000
    elif taxable_income <= 500000000:
        tax = taxable_income * 0.40 - 25400000
    elif taxable_income <= 1000000000:
        tax = taxable_income * 0.42 - 33400000
    else:
        tax = taxable_income * 0.45 - 45400000
    return max(int(tax), 0)

