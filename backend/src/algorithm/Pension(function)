#### 노령연금 계산, 개인연금 계산, 일시금 계산 ####

def Health(): 
  return 0;

def Finance(): 
  return 0;

def decide_private_payment_period(health_score, finance_score): # 개인연금 확정/종신 판별 // 수정예정
    if health_score >= 80 and finance_score >= 80:
        return 20
    elif health_score <= 40 or finance_score <= 40:
        return 10
    else:
        return 15

def decide_private_lump_sum(health_score, finance_score): # 개인연금 일시금 결정 // 수정예정
    if health_score <= 40 or finance_score <= 60:
        return True
    else:
        return False

def calculate_public_pension(user_info, adjustment_years=0, adjustment_type="normal"): # 노령연금 계산 
    if not user_info.get("Public_pension", False):
        return 0
    if user_info["Subscription_period"] < 10:
        return 0
    A_value = 2756000
    B_rate = 0.012 * user_info["Subscription_period"]
    estimated_monthly_pension = A_value * B_rate
    spouse_bonus = 269360 if user_info["Spouse"] == 'Y' else 0
    parent_bonus = user_info["Dependent_parent_count"] * 179580
    child_bonus = user_info["Child_count"] * 179580
    estimated_monthly_pension += spouse_bonus + parent_bonus + child_bonus
    if adjustment_type == "early" and 1 <= adjustment_years <= 5:
        estimated_monthly_pension *= (1 - 0.06 * adjustment_years)
    elif adjustment_type == "deferred" and 1 <= adjustment_years <= 5:
        estimated_monthly_pension *= (1 + 0.072 * adjustment_years)
    return estimated_monthly_pension

def calculate_private_pension(user_info): # 개인연금 계산 
    if not user_info.get("Private_pension"):
        return 0

    total_paid = user_info["Private_monthly_premium"] * 12 * user_info["Private_subscription_period"]

    if user_info.get("Private_lump_sum", False):
        return total_paid

    private_pension_type = user_info.get("Private_pension_type")

    if private_pension_type == "확정형":
        payment_period_years = user_info.get("Private_payment_period")
        if payment_period_years is None:
            payment_period_years = decide_private_payment_period(user_info["Health_score"], user_info["Finance_score"])
        return total_paid / (payment_period_years * 12)
    elif private_pension_type == "종신형":
        rate = 0.008
        private_annual_pension = total_paid * rate
        return private_annual_pension / 12

    return 0

def calculate_public_lump_sum(user_info): # 일시금 계산
    if not user_info.get("Public_pension", False):
        return 0
    A_value = 2756000
    B_rate = 0.012 * user_info["Subscription_period"]
    lump_sum = A_value * B_rate * 12 * 5
    return lump_sum

def generate_lump_sum_result(user_info): # 일시금 결과
    lump_sum = calculate_public_lump_sum(user_info)
    tax = calculate_lump_sum_tax(lump_sum)
    return {
        "일시금 총액(예상)": int(lump_sum),
        "일시금 예상 세금": int(tax),
        "일시금 세후 예상액": int(lump_sum - tax)
    }


